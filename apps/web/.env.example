# Both of these are NEXT_PUBLIC_*, which means Next inlines them into the
# JavaScript bundle at BUILD time. Setting them in PM2, systemd or a shell at
# run time does nothing — the value is already baked in. Export them before
# `next build`, or rebuild after changing them.

# Where the Fastify API lives. In production Nginx proxies /api on the same
# origin, so this is just the site's own URL — no CORS, no preflight.
#   production: https://heirlom.fun
NEXT_PUBLIC_API_URL=http://localhost:4000

# The canonical site URL. metadataBase uses it to make og:image absolute; a
# relative og:image is ignored by every scraper, so link previews on X come up
# blank if this is wrong.
#   production: https://heirlom.fun
NEXT_PUBLIC_SITE_URL=http://localhost:3000
