{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "overrides": [
    {
      "files": ["src/game/*.js"],
      "env": { "browser": true, "es2022": true },
      "parserOptions": { "ecmaVersion": 2022, "sourceType": "module" },
      "rules": {
        "no-undef": "error",
        "no-unused-vars": ["warn", { "args": "none", "varsIgnorePattern": "^_" }]
      }
    }
  ]
}
