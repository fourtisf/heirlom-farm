# Server tests run against a real Postgres and Redis — they test transactional
# races, and a fake would pass while proving nothing. Point these at a throwaway
# database; the suite writes freely and does not clean up between runs.
DATABASE_URL=postgresql://heirlom:heirlom@localhost:5432/heirlom_test
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=test-secret-test-secret-test-secret-1234
NODE_ENV=test
