NODE_ENV=development
PORT=4000
# Loopback: nginx proxies to this, and nothing else should reach it. Set
# 0.0.0.0 only inside a container that must accept traffic from outside its
# own network namespace.
HOST=127.0.0.1

DATABASE_URL=postgresql://heirlom:heirlom@localhost:5432/heirlom
REDIS_URL=redis://127.0.0.1:6379

# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
SESSION_TTL=7d
# Same origin in production behind Nginx, so this is never exercised there —
# but it must still be right, since a wrong value fails closed.
#   production: https://heirlom.fun,https://www.heirlom.fun
CORS_ORIGIN=http://localhost:3000

# $SEED withdrawals. Anything above WITHDRAW_AUTO_LIMIT waits for review.
WITHDRAW_MIN=5
WITHDRAW_AUTO_LIMIT=50
WITHDRAW_COOLDOWN_HOURS=24
